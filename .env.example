# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Group Chat ID for the dorm (typically negative, e.g. -1001234567890)
GROUP_ID=-1001234567890

# Admin's Telegram User ID (numeric, from @userinfobot)
ADMIN_ID=111111111

# Rotation Start Date in YYYY-MM-DD format (e.g. 2026-11-23 Monday)
# Announcement: Monday Nov 23, 08:00 AM | Cleaners & Check: Friday Nov 27, 08:00 PM
# Week 1 starts with Pair 1 (Bilisuma & Nahom)
START_DATE=2026-11-23

# Schedule configurations (Timezone: Africa/Addis_Ababa)
ANNOUNCE_DAY=mon
ANNOUNCE_TIME=08:00
REMINDER_DAY=thu
REMINDER_TIME=18:00
CHECK_DAY=fri
CHECK_TIME=20:00

# Hours the approver has to confirm after Friday check before falling back
APPROVER_TIMEOUT_HOURS=12

# Total fine amount in ETB per missed week (split equally between the 2 cleaners)
FINE_TOTAL=100
